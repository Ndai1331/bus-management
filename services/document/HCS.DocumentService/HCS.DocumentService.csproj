<Project Sdk="Microsoft.NET.Sdk.Web">
  <Import Project="../../../common.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HCS.DocumentService</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HCS.DocumentService.Contracts/HCS.DocumentService.Contracts.csproj" />
    <InternalsVisibleTo Include="HCS.DocumentService.Tests" />
    <ProjectReference Include="../../../building-blocks/HCS.IntegrationEvents/HCS.IntegrationEvents.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OpenIddict.Validation.AspNetCore" Version="7.5.0" />
    <PackageReference Include="OpenIddict.Validation.SystemNetHttp" Version="7.5.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Bnn.SignLib" Version="1.2.5" />
    <PackageReference Include="Bnn.Sdk" Version="1.1.3" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.4.1" />
    <PackageReference Include="PdfPig" Version="0.1.13" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.AspNetCore.Serilog" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Autofac" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.BlobStoring.Minio" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.EntityFrameworkCore.PostgreSql" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.EventBus.RabbitMQ" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.OpenIddict.AspNetCore" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Swashbuckle" Version="10.6.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Provider helpers are vendored under this project so Docker builds remain
         self-contained while preserving the licensed runtime wire/PDF behavior. -->
    <EmbeddedResource Include="Signing/ProviderShared/BnnSoftSigns/*.png" />
    <EmbeddedResource Include="Signing/ProviderShared/electronic-signature-layout*.png" />
  </ItemGroup>
</Project>

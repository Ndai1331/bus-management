{
  "Urls": "https://localhost:44402",
  "App": {
    "CorsOrigins": [
      "https://localhost:44403"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Yarp.ReverseProxy": "Information"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "platform-abp": { "ClusterId": "Platform", "Match": { "Path": "/api/abp/{**catch-all}" } },
      "platform-account": { "ClusterId": "Platform", "Match": { "Path": "/api/account/{**catch-all}" } },
      "platform-identity": { "ClusterId": "Platform", "Match": { "Path": "/api/identity/{**catch-all}" } },
      "platform-permissions": { "ClusterId": "Platform", "Match": { "Path": "/api/permission-management/{**catch-all}" } },
      "platform-settings": { "ClusterId": "Platform", "Match": { "Path": "/api/setting-management/{**catch-all}" } },
      "platform-languages": { "ClusterId": "Platform", "Match": { "Path": "/api/language-management/{**catch-all}" } },
      "platform-audit": { "ClusterId": "Platform", "Match": { "Path": "/api/audit-logs/{**catch-all}" } },
      "platform-admin": { "ClusterId": "Platform", "Match": { "Path": "/api/admin/{**catch-all}" } },
      "platform-chat-contacts": { "ClusterId": "Platform", "Order": -1, "Match": { "Path": "/api/chat/contacts/{**catch-all}" } },
      "organization-root": { "ClusterId": "Organization", "Match": { "Path": "/api/organization/{**catch-all}" } },
      "organization-departments": { "ClusterId": "Organization", "Match": { "Path": "/api/departments/{**catch-all}" } },
      "organization-units": { "ClusterId": "Organization", "Match": { "Path": "/api/units/{**catch-all}" } },
      "organization-positions": { "ClusterId": "Organization", "Match": { "Path": "/api/positions/{**catch-all}" } },
      "organization-master-data": { "ClusterId": "Organization", "Match": { "Path": "/api/master-data/{**catch-all}" } },
      "document-documents": { "ClusterId": "Document", "Match": { "Path": "/api/documents/{**catch-all}" } },
      "document-workflows": { "ClusterId": "Document", "Match": { "Path": "/api/workflows/{**catch-all}" } },
      "document-signing": { "ClusterId": "Document", "Match": { "Path": "/api/signing/{**catch-all}" } },
      "work-projects": { "ClusterId": "WorkManagement", "Match": { "Path": "/api/projects/{**catch-all}" } },
      "work-project-tasks": { "ClusterId": "WorkManagement", "Match": { "Path": "/api/project-tasks/{**catch-all}" } },
      "work-calendar": { "ClusterId": "WorkManagement", "Match": { "Path": "/api/calendar/{**catch-all}" } },
      "work-surveys": { "ClusterId": "WorkManagement", "Match": { "Path": "/api/surveys/{**catch-all}" } },
      "work-reports": { "ClusterId": "WorkManagement", "Match": { "Path": "/api/reports/{**catch-all}" } },
      "work-dashboard": { "ClusterId": "WorkManagement", "Match": { "Path": "/api/dashboard/{**catch-all}" } },
      "collaboration-chat": { "ClusterId": "Collaboration", "Match": { "Path": "/api/chat/{**catch-all}" } },
      "collaboration-notifications": { "ClusterId": "Collaboration", "Match": { "Path": "/api/notifications/{**catch-all}" } },
      "collaboration-chat-hub": { "ClusterId": "Collaboration", "Match": { "Path": "/hubs/chat/{**catch-all}" } },
      "bus-management": { "ClusterId": "BusManagement", "Match": { "Path": "/api/bus-management/{**catch-all}" } }
    },
    "Clusters": {
      "Platform": {
        "Destinations": { "primary": { "Address": "https://localhost:44411/" } }
      },
      "Organization": {
        "Destinations": { "primary": { "Address": "https://localhost:44412/" } }
      },
      "Document": {
        "Destinations": { "primary": { "Address": "https://localhost:44413/" } }
      },
      "WorkManagement": {
        "Destinations": { "primary": { "Address": "https://localhost:44414/" } }
      },
      "Collaboration": {
        "Destinations": { "primary": { "Address": "https://localhost:44415/" } }
      },
      "BusManagement": {
        "Destinations": { "primary": { "Address": "https://localhost:44416/" } }
      }
    }
  }
}

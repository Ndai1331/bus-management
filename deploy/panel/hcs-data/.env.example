# Copy to .env in this folder: /www/server/panel/data/compose/hcs-data/.env
#
# BỎ QUA stack này nếu Postgres + MinIO đã chạy trên 10.17.227.64 (axis/cms)
# và HCS apps chỉ kết nối qua HCS_DATA_HOST trong hcs/.env.
#
# Chỉ chạy hcs-data khi cần Redis + RabbitMQ riêng cho HCS trên cùng máy apps.

HCS_DATA_HOST=10.17.227.64

# Khớp Postgres shared trên 10.17.227.64 (nếu vẫn dùng container postgres trong stack)
HCS_POSTGRES_USER=postgres
HCS_POSTGRES_PASSWORD=bvh@1894

HCS_REDIS_PASSWORD=dev-redis-2026
HCS_RABBITMQ_USER=hcs-events
HCS_RABBITMQ_PASSWORD=dev-rabbitmq-2026

# Khớp MinIO shared trên 10.17.227.64 (nếu vẫn dùng container minio trong stack)
HCS_MINIO_ROOT_USER=axisadmin
HCS_MINIO_ROOT_PASSWORD="axisadminpassword@12!!!"

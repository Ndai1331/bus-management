# Copy to .env on APPS server: /www/server/panel/data/compose/hcs/.env
# chmod 600 .env
#
# Kiến trúc HTL Tech (2 server):
#   10.17.227.58 — HCS apps + Redis + RabbitMQ + Nginx (máy này chạy ./up.sh)
#   10.17.227.64 — Postgres + MinIO (axis/cms stack)
# PFX: ./.hcs-certs/openiddict.pfx, dataprotection.pfx


HCS_APPS_HOST=10.17.227.58
HCS_DATA_HOST=10.17.227.64

# Container → Postgres + MinIO trên server data (.64)
HCS_POSTGRES_HOST=10.17.227.64
HCS_MINIO_HOST=10.17.227.64

# Container → Redis + Rabbit (cùng compose project — hostname docker)
HCS_REDIS_HOST=redis
HCS_RABBITMQ_HOST=rabbitmq

# up.sh chạy trên HOST .58 — wait đúng từng server
HCS_POSTGRES_WAIT_HOST=10.17.227.64
HCS_MINIO_WAIT_HOST=10.17.227.64
HCS_REDIS_WAIT_HOST=127.0.0.1
HCS_RABBITMQ_WAIT_HOST=127.0.0.1

# Nếu tách project hcs-infra riêng, đổi thành host.docker.internal:
# HCS_REDIS_HOST=host.docker.internal
# HCS_RABBITMQ_HOST=host.docker.internal

# Bỏ qua chờ port (debug): HCS_SKIP_PORT_WAIT=true

HCS_PUBLIC_HOST=hanhchinhso.htltech.vn
HCS_API_PUBLIC_HOST=api-hcs.htltech.vn
HCS_AUTH_PUBLIC_HOST=auth-hcs.htltech.vn
HCS_SSO_PUBLIC_HOST=sso-hcs.htltech.vn

Bff__CookieDomain=htltech.vn

HCS_DOCKER_REGISTRY=longnguyen1331/hanhchinhso
HCS_PULL_IMAGES=true

HCS_POSTGRES_USER=postgres
HCS_POSTGRES_PASSWORD=change-me

HCS_REDIS_PASSWORD=change-me
HCS_RABBITMQ_USER=hcs-events
HCS_RABBITMQ_PASSWORD=change-me

HCS_MINIO_ROOT_USER=change-me
HCS_MINIO_ROOT_PASSWORD=change-me

HCS_ADMIN_PASSWORD=change-me
HCS_GATEWAY_CLIENT_SECRET=change-me
HCS_KEYCLOAK_ADMIN=change-me
HCS_KEYCLOAK_ADMIN_PASSWORD=change-me
HCS_KEYCLOAK_CLIENT_SECRET=change-me

HCS_OPENIDDICT_PFX=/www/server/panel/data/compose/hcs/.hcs-certs/openiddict.pfx
HCS_OPENIDDICT_PFX_PASSWORD=change-me
HCS_DATAPROTECTION_PFX=/www/server/panel/data/compose/hcs/.hcs-certs/dataprotection.pfx
HCS_DATAPROTECTION_PFX_PASSWORD=change-me

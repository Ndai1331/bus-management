<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HCS.AuthServer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.9" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Volo.Abp.Account.Application" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Account.Web.OpenIddict" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc.UI.Theme.LeptonXLite" Version="5.6.0" />
    <PackageReference Include="Volo.Abp.AspNetCore.Serilog" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Autofac" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.PermissionManagement.Domain.Identity" Version="10.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\HCS.Application.Contracts\HCS.Application.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\HCS.Domain\HCS.Domain.csproj" />
    <ProjectReference Include="..\..\..\src\HCS.EntityFrameworkCore\HCS.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\favicon.ico" />
    <Content Include="..\..\..\src\HCS.Blazor\wwwroot\images\logo\logo.png"
             Link="wwwroot\images\logo\logo.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\src\HCS.Blazor\wwwroot\favicon.ico"
             Link="wwwroot\favicon.ico"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

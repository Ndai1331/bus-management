@page "/bus-management"
@attribute [Authorize(Policy = "HCS.BusManagement.Reports")]
@inherits HCSComponentBase
@using HCS.BusManagementService.Contracts
@using Microsoft.AspNetCore.Authorization
@inject BusManagementClient BusClient

<PageTitle>Quản lý bến xe · HCS</PageTitle>

<section class="hcs-feature bus-dashboard" aria-labelledby="bus-dashboard-title">
    <header class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <p class="text-muted mb-1">HCS Bus Management</p>
            <h1 id="bus-dashboard-title" class="mb-1">Dashboard bến xe</h1>
            <p class="text-muted mb-0">Tổng hợp vận hành, doanh thu và đối soát theo ngày nghiệp vụ.</p>
        </div>
        <button class="btn btn-outline-primary" @onclick="RefreshAsync" disabled="@isLoading">
            <i class="fa fa-rotate me-1" aria-hidden="true"></i> Làm mới
        </button>
    </header>

    @if (isLoading)
    {
        <div class="alert alert-info" role="status">Đang tải dữ liệu bến xe…</div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    else if (dashboard is not null)
    {
        <div class="row g-3 mb-4">
            @Metric("Doanh thu thuần", $"{dashboard.NetRevenue:N0} đ", "fa-money-bill-wave")
            @Metric("Chi phí thuần", $"{dashboard.NetExpense:N0} đ", "fa-receipt")
            @Metric("Chuyến xe", dashboard.DepartureCount.ToString("N0"), "fa-bus")
            @Metric("Ca chưa chốt", dashboard.UnreconciledShiftCount.ToString("N0"), "fa-clipboard-check")
        </div>

        <div class="row g-3">
            <div class="col-12 col-xl-8">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <h2 class="h5 mb-0">Doanh thu theo nguồn</h2>
                            <AuthorizeView Policy="HCS.BusManagement.Reports.Export">
                                <Authorized>
                                    <div class="btn-group btn-group-sm" role="group" aria-label="Xuất báo cáo doanh thu">
                                        <a class="btn btn-outline-secondary" href="@ExportUrl("revenue", "xlsx")">XLSX</a>
                                        <a class="btn btn-outline-secondary" href="@ExportUrl("revenue", "pdf")">PDF</a>
                                        <a class="btn btn-outline-secondary" target="_blank" rel="noopener" href="@ExportUrl("revenue", "html")">In</a>
                                    </div>
                                </Authorized>
                            </AuthorizeView>
                        </div>
                        @if (revenueRows.Count == 0)
                        {
                            <p class="text-muted mb-0">Chưa có số liệu trong kỳ.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead><tr><th>Nguồn thu</th><th class="text-end">Số phiếu</th><th class="text-end">Điều chỉnh</th><th class="text-end">Thuần</th></tr></thead>
                                    <tbody>
                                    @foreach (var row in revenueRows)
                                    {
                                        <tr><td>@row.SourceType</td><td class="text-end">@row.ReceiptCount</td><td class="text-end">@row.AdjustmentAmount.ToString("N0") đ</td><td class="text-end">@row.NetAmount.ToString("N0") đ</td></tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-12 col-xl-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h5">Cảnh báo vận hành</h2>
                        <p class="mb-2"><i class="fa fa-file-circle-exclamation text-warning me-2"></i>Hồ sơ xe sắp hết hạn: <strong>@dashboard.ExpiringDocumentCount</strong></p>
                        <p class="mb-2"><i class="fa fa-file-signature text-warning me-2"></i>Hợp đồng nhà xe sắp hết hạn: <strong>@dashboard.ExpiringContractCount</strong></p>
                        <p class="mb-2"><i class="fa fa-building text-warning me-2"></i>Hợp đồng mặt bằng sắp hết hạn: <strong>@dashboard.ExpiringLeaseCount</strong></p>
                        <p class="mb-0"><i class="fa fa-clock text-secondary me-2"></i>Cập nhật: @dashboard.AsOfUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                </div>
            </div>
        </div>

        @if (dashboard.StationRows is { Count: > 0 })
        {
            <div class="card mt-3">
                <div class="card-body">
                    <h2 class="h5">Tổng hợp theo bến</h2>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead><tr><th>Bến</th><th class="text-end">Doanh thu thuần</th><th class="text-end">Chi phí thuần</th><th class="text-end">Chuyến</th><th class="text-end">Ca chưa chốt</th></tr></thead>
                            <tbody>
                            @foreach (var row in dashboard.StationRows)
                            {
                                <tr><td class="font-monospace">@row.StationId.ToString("D")</td><td class="text-end">@row.NetRevenue.ToString("N0") đ</td><td class="text-end">@row.NetExpense.ToString("N0") đ</td><td class="text-end">@row.DepartureCount</td><td class="text-end">@row.UnreconciledShiftCount</td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</section>

@code {
    private DashboardSummaryDto? dashboard;
    private IReadOnlyList<RevenueReportRowDto> revenueRows = [];
    private bool isLoading;
    private string? error;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        isLoading = true; error = null;
        try
        {
            var to = DateTime.Now.Date;
            var from = new DateTime(to.Year, to.Month, 1);
            dashboard = await BusClient.GetDashboardAsync(from, to) ?? throw new InvalidOperationException("Gateway returned an empty dashboard.");
            revenueRows = await BusClient.GetRevenueReportAsync(from, to) ?? [];
        }
        catch (Exception exception) { error = exception.Message; }
        finally { isLoading = false; }
    }

    private string ExportUrl(string reportType, string format)
    {
        var encodedFrom = Uri.EscapeDataString(from.ToString("O"));
        var encodedTo = Uri.EscapeDataString(to.ToString("O"));
        return $"/api/bus-management/exports/{reportType}?format={format}&from={encodedFrom}&to={encodedTo}";
    }
    private DateTime from => dashboard?.From ?? new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
    private DateTime to => dashboard?.To ?? DateTime.Now.Date;

}

@* Keep the metric markup local so this first vertical slice does not introduce a shared UI dependency. *@
@code {
    private RenderFragment Metric(string Title, string Value, string Icon) => builder =>
    {
        builder.OpenElement(0, "div"); builder.AddAttribute(1, "class", "col-12 col-sm-6 col-xl-3");
        builder.OpenElement(2, "div"); builder.AddAttribute(3, "class", "card h-100"); builder.OpenElement(4, "div"); builder.AddAttribute(5, "class", "card-body");
        builder.OpenElement(6, "div"); builder.AddAttribute(7, "class", "d-flex align-items-center justify-content-between");
        builder.OpenElement(8, "div"); builder.OpenElement(9, "div"); builder.AddAttribute(10, "class", "text-muted small"); builder.AddContent(11, Title); builder.CloseElement();
        builder.OpenElement(12, "div"); builder.AddAttribute(13, "class", "h4 mb-0"); builder.AddContent(14, Value); builder.CloseElement(); builder.CloseElement();
        builder.OpenElement(15, "i"); builder.AddAttribute(16, "class", $"fa {Icon} fa-2x text-primary"); builder.AddAttribute(17, "aria-hidden", "true"); builder.CloseElement();
        builder.CloseElement(); builder.CloseElement(); builder.CloseElement(); builder.CloseElement();
    };
}

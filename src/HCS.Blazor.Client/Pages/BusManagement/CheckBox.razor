<label class="form-check form-check-inline">
    <input class="form-check-input" type="checkbox" checked="@Value" @onchange="OnChanged" />
    <span class="form-check-label">@Label</span>
</label>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    private Task OnChanged(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase));
}

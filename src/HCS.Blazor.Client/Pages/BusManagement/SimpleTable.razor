<div class="card">
    <div class="card-body pb-0"><h3 class="h6">@Title</h3></div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr>@foreach (var header in Headers.Split('|')) { <th>@header</th> }</tr></thead>
            @ChildContent
        </table>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Headers { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

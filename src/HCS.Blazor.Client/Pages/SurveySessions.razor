@page "/survey-sessions"
@attribute [Authorize(Policy = "WorkManagement.Surveys")]
@inherits HCSComponentBase
@inject WorkManagementClient Work
@inject IUiMessageService UiMessage

<PageTitle>@L["Menu:Surveys"] · HCS</PageTitle>
<section class="hcs-catalog-page">
    <header class="hcs-catalog-titlebar">
        <div class="min-w-0"><h1>@L["Feature:SurveySessions"]</h1></div>
        <div class="hcs-catalog-page__actions">
            <Button Color="Color.Primary" Outline="true" Class="hcs-catalog-export" Clicked="LoadAsync" Disabled="@isLoading">@L["Catalog:Refresh"]</Button>
            <Button Color="Color.Primary" Class="hcs-catalog-create" Clicked="OpenCreate"><Icon Name="@IconName.Add" /> @L["Catalog:New"]</Button>
        </div>
    </header>
    <Card Class="mb-2 hcs-catalog-filter-card"><CardBody>
        <div class="hcs-catalog-filter-row">
            <Addons Class="hcs-catalog-search">
                <Addon AddonType="AddonType.Body"><TextInput @bind-Value="filter" Placeholder="@L["Catalog:SearchPlaceholder"]" /></Addon>
                <Addon AddonType="AddonType.End">
                    <Button Color="Color.Primary" Clicked="SearchAsync"><i class="fa fa-search me-1"></i> @L["Catalog:SearchButton"]</Button>
                </Addon>
            </Addons>
            <Button Color="Color.Primary" Outline="true" Class="hcs-catalog-filter-toggle" Clicked="() => showFilters = !showFilters">
                <i class="fa fa-sliders me-2"></i>@L["Catalog:Filter"]
                <i class="fa @(showFilters ? "fa-chevron-up" : "fa-chevron-down") ms-2"></i>
            </Button>
        </div>
        @if (showFilters)
        {
            <div class="hcs-catalog-advanced-filter">
                <Field>
                    <FieldLabel>@L["Catalog:Status"]</FieldLabel>
                    <Select TValue="string" @bind-Value="statusFilter" @bind-Value:after="SearchAsync">
                        <SelectItem Value="@string.Empty">@L["Catalog:AllStatuses"]</SelectItem>
                        <SelectItem Value="@("Active")">@L["Catalog:Active"]</SelectItem>
                        <SelectItem Value="@("Closed")">@L["Catalog:Closed"]</SelectItem>
                    </Select>
                </Field>
                <Button Color="Color.Light" Outline="true" Class="hcs-catalog-filter-reset" Clicked="ResetSearchAsync">@L["Catalog:Reset"]</Button>
            </div>
        }
    </CardBody></Card>
    <Card Class="hcs-catalog-grid-card"><CardBody>
        <DataGrid TItem="SurveySessionDto" Data="@pageItems" TotalItems="@totalCount" ReadData="OnReadAsync"
                  ShowPager="true" ShowPageSizes="true" PageSizes="@pageSizes" PageSize="@pageSize"
                  Responsive="true" Striped="true" Hoverable="true" Class="hcs-catalog-grid">
            <EmptyTemplate>
                <div class="hcs-empty py-5"><i class="fa fa-inbox"></i><h2>@L["Catalog:EmptyTitle"]</h2><p>@L["Catalog:EmptyDescription"]</p></div>
            </EmptyTemplate>
            <LoadingTemplate>
                <div class="hcs-loading py-5"><i class="fa fa-spinner fa-spin"></i><span>@L["Catalog:Loading"]</span></div>
            </LoadingTemplate>
            <DataGridColumns>
                <DataGridColumn TItem="SurveySessionDto" Caption="@L["Catalog:Code"].Value">
                    <DisplayTemplate Context="cell">
                        <strong>@cell.Item.Name</strong>
                        <span class="hcs-catalog-code">#@cell.Item.Code</span>
                    </DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="SurveySessionDto" Caption="@L["Feature:StartDate"].Value">
                    <DisplayTemplate Context="cell">@cell.Item.StartsAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") – @cell.Item.EndsAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="SurveySessionDto" Caption="@L["Catalog:Status"].Value">
                    <DisplayTemplate Context="cell"><span class="hcs-status-badge @SessionStatusClass(cell.Item.Status)">@SessionStatusText(cell.Item.Status)</span></DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="SurveySessionDto" Caption="@L["Catalog:Actions"].Value">
                    <DisplayTemplate Context="cell">
                        <div class="hcs-row-actions">
                            <Button Size="Size.Small" Color="Color.Primary" Outline="true" Class="hcs-action-button" Clicked="() => Edit(cell.Item)"><Icon Name="@IconName.Edit" /></Button>
                            <Button Size="Size.Small" Color="Color.Success" Outline="true" Class="hcs-action-button" Clicked="@(() => ChangeStatusAsync(cell.Item, "Active"))">@L["Catalog:Active"]</Button>
                            <Button Size="Size.Small" Color="Color.Secondary" Outline="true" Class="hcs-action-button" Clicked="@(() => ChangeStatusAsync(cell.Item, "Closed"))">@L["Catalog:Closed"]</Button>
                            @if (cell.Item.LocationId is { } locationId)
                            {
                                <a class="btn btn-sm btn-outline-primary hcs-action-button" href="@($"/survey-collections/{locationId}")">@L["Feature:Collect"]</a>
                            }
                            <Button Size="Size.Small" Color="Color.Danger" Outline="true" Class="hcs-action-button hcs-action-button--delete" Clicked="() => DeleteAsync(cell.Item)"><Icon Name="@IconName.Delete" /></Button>
                        </div>
                    </DisplayTemplate>
                </DataGridColumn>
            </DataGridColumns>
        </DataGrid>
    </CardBody></Card>
</section>

<Modal @ref="modal" Size="ModalSize.Default"><ModalContent Centered Class="hcs-catalog-modal">
    <ModalHeader Class="hcs-catalog-modal__header"><ModalTitle>@(editingId is null ? L["Catalog:Create"] : L["Catalog:Edit"])</ModalTitle><CloseButton /></ModalHeader>
    <ModalBody Class="hcs-catalog-modal__body">
        <div class="hcs-catalog-form">
            <div class="hcs-form-row">
                <Field><FieldLabel>@L["Catalog:Code"]</FieldLabel><HcsIsolatedTextInput @bind-Value="form.Code" Name="hcsSurveySessionCode" MaxLength="64" Disabled="@(editingId is not null)" /></Field>
                <Field><FieldLabel>@L["Catalog:Name"]</FieldLabel><HcsIsolatedTextInput @bind-Value="form.Name" Name="hcsSurveySessionName" /></Field>
            </div>
            <Field><FieldLabel>@L["Menu:SurveyLocations"]</FieldLabel>
                <Select TValue="string" @bind-Value="form.LocationId">
                    <SelectItem Value="@string.Empty">@L["Catalog:NoParent"]</SelectItem>
                    @foreach (var location in locations) { <SelectItem Value="@location.Id.ToString()">@location.Name</SelectItem> }
                </Select>
            </Field>
            <div class="hcs-form-row hcs-form-row--equal">
                <Field><FieldLabel>@L["Feature:StartDate"]</FieldLabel><HcsDatePicker TValue="DateTime" @bind-Value="form.StartsAt" InputMode="DateInputMode.DateTime" ShowTodayButton ShowClearButton /></Field>
                <Field><FieldLabel>@L["Feature:EndDate"]</FieldLabel><HcsDatePicker TValue="DateTime" @bind-Value="form.EndsAt" InputMode="DateInputMode.DateTime" ShowTodayButton ShowClearButton /></Field>
            </div>
        </div>
    </ModalBody>
    <ModalFooter Class="hcs-catalog-modal__footer">
        <Button Color="Color.Secondary" Class="hcs-catalog-cancel" Clicked="() => modal!.Hide()">@L["Catalog:Cancel"]</Button>
        <Button Color="Color.Primary" Class="hcs-catalog-save" Clicked="SaveAsync">@L["Catalog:SaveChanges"]</Button>
    </ModalFooter>
</ModalContent></Modal>
@code {
    private static readonly int[] pageSizes = [10, 20, 50, 100];
    private readonly List<SurveySessionDto> sessions = [];
    private readonly List<SurveySessionDto> pageItems = [];
    private readonly List<SurveyLocationDto> locations = [];
    private readonly SessionForm form = new();
    private Modal? modal;
    private Guid? editingId;
    private string filter = "", statusFilter = "";
    private bool isLoading, showFilters, loaded;
    private int totalCount, pageSize = 20, currentPage = 1;

    private async Task OnReadAsync(DataGridReadDataEventArgs<SurveySessionDto> args)
    {
        currentPage = Math.Max(args.Page, 1);
        pageSize = Math.Clamp(args.PageSize, 10, 100);
        if (!loaded) await LoadAsync();
        else ApplyPage();
    }

    private Task SearchAsync() { currentPage = 1; ApplyPage(); return Task.CompletedTask; }
    private Task ResetSearchAsync() { filter = statusFilter = ""; showFilters = false; currentPage = 1; ApplyPage(); return Task.CompletedTask; }

    private void ApplyPage()
    {
        var filtered = sessions.Where(Matches).ToList();
        totalCount = filtered.Count;
        pageItems.Clear();
        pageItems.AddRange(filtered.Skip((currentPage - 1) * pageSize).Take(pageSize));
    }

    private bool Matches(SurveySessionDto item)
    {
        if (!string.IsNullOrWhiteSpace(filter))
        {
            var term = SearchText.Normalize(filter);
            if (item.Code.IndexOf(term, StringComparison.OrdinalIgnoreCase) < 0 &&
                item.Name.IndexOf(term, StringComparison.OrdinalIgnoreCase) < 0)
                return false;
        }
        if (!string.IsNullOrWhiteSpace(statusFilter) &&
            !string.Equals(item.Status, statusFilter, StringComparison.OrdinalIgnoreCase))
            return false;
        return true;
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            sessions.Clear(); sessions.AddRange(await Work.GetSessionsAsync());
            locations.Clear(); locations.AddRange(await Work.GetLocationsAsync());
            loaded = true;
            ApplyPage();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
        finally { isLoading = false; }
    }
    private async Task OpenCreate() { editingId = null; form.Reset(); if (modal is not null) await modal.Show(); }
    private async Task Edit(SurveySessionDto session)
    {
        editingId = session.Id;
        form.Code = session.Code; form.Name = session.Name; form.LocationId = session.LocationId?.ToString() ?? "";
        form.StartsAt = session.StartsAt.ToLocalTime(); form.EndsAt = session.EndsAt.ToLocalTime();
        if (modal is not null) await modal.Show();
    }
    private async Task SaveAsync()
    {
        try
        {
            Guid? location = Guid.TryParse(form.LocationId, out var id) ? id : null;
            if (editingId is { } sessionId) await Work.UpdateSessionAsync(sessionId, new UpdateSurveySessionRequest(form.Name.Trim(), form.StartsAt, form.EndsAt, location));
            else await Work.CreateSessionAsync(new CreateSurveySessionRequest(form.Code.Trim(), form.Name.Trim(), form.StartsAt, form.EndsAt, location));
            await NotifySuccessAsync(editingId is null ? L["Catalog:Created"] : L["Catalog:Updated"]);
            if (modal is not null) await modal.Hide();
            form.Reset(); await LoadAsync();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }
    private async Task ChangeStatusAsync(SurveySessionDto session, string status)
    {
        try { await Work.ChangeSessionStatusAsync(session.Id, status); await NotifySuccessAsync(L["Catalog:Updated"]); await LoadAsync(); }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }

    private string SessionStatusText(string status) => status switch
    {
        "Active" => L["SurveySession:Status.Active"].Value,
        "Closed" => L["SurveySession:Status.Closed"].Value,
        _ => status
    };

    private static string SessionStatusClass(string status) => status switch
    {
        "Active" => "hcs-status-badge--success",
        "Closed" => "hcs-status-badge--todo",
        _ => "hcs-status-badge--planning"
    };
    private async Task DeleteAsync(SurveySessionDto session)
    {
        if (!await UiMessage.Confirm(string.Format(L["Catalog:DeleteConfirmation"], session.Name))) return;
        try { await Work.DeleteSessionAsync(session.Id); await NotifySuccessAsync(L["Catalog:Deleted"]); await LoadAsync(); }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Delete); }
    }
    private sealed class SessionForm
    {
        public string Code { get; set; } = ""; public string Name { get; set; } = ""; public string LocationId { get; set; } = "";
        public DateTime StartsAt { get; set; } = DateTime.Now; public DateTime EndsAt { get; set; } = DateTime.Now.AddDays(7);
        public void Reset() { Code = Name = LocationId = ""; StartsAt = DateTime.Now; EndsAt = DateTime.Now.AddDays(7); }
    }
}

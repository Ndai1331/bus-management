    private Guid? DepartmentId(SigningQueueItem item) =>
        SubmitterId(item) is { } submitter && submitterDepartmentIds.TryGetValue(submitter, out var department)
            ? department
            : null;
    private string ContactName(Guid? id)
    {
        if (id is not { } userId) return "";
        return contacts.FirstOrDefault(x => x.Id == userId)?.DisplayName
            ?? submitterDisplayNames.GetValueOrDefault(userId)
            ?? (currentUserId == userId ? currentUserDisplayName : "")
            ?? "";
    }
    private string DepartmentName(Guid? id)
    {
        if (id is not { } departmentId) return "";
        return departments.FirstOrDefault(x => x.Id == departmentId)?.Name
            ?? departmentNamesById.GetValueOrDefault(departmentId)
            ?? "";
    }
    private async Task LoadUserLookupsAsync()
    {
        var submitterIds = queue.Select(SubmitterId).Where(x => x.HasValue).Select(x => x!.Value).Distinct().ToArray();
        var workflowUserIds = queue.SelectMany(item => item.Instance.Tasks.SelectMany(task => new[] { task.DecidedBy, task.AssigneeUserId }))
            .Concat(queue.Select(item => item.Document.FromUserId))
            .Where(x => x.HasValue).Select(x => x!.Value).Distinct().ToArray();
        var allUserIds = submitterIds.Concat(workflowUserIds).Distinct().ToArray();
        submitterDepartmentIds.Clear();
        submitterDisplayNames.Clear();
        departmentNamesById.Clear();
        workflowUserNames.Clear();
        if (allUserIds.Length == 0 && submitterIds.Length == 0) return;

        var usersTask = allUserIds.Length == 0
            ? Task.FromResult(new List<WorkflowAssigneeCandidateDto>())
            : Documents.GetWorkflowUserLookupAsync(allUserIds);
        Task<IReadOnlyList<UserDepartmentLookupDto>> departmentsTask = submitterIds.Length == 0
            ? Task.FromResult<IReadOnlyList<UserDepartmentLookupDto>>([])
            : Catalog.GetUserDepartmentsAsync(submitterIds);

        try
        {
            var users = await usersTask;
            foreach (var user in users)
            {
                var displayName = UserDisplayNames.FirstReal(user.DisplayName, user.UserName);
                if (!string.IsNullOrWhiteSpace(displayName)) submitterDisplayNames[user.UserId] = displayName;
                if (!string.IsNullOrWhiteSpace(displayName)) workflowUserNames[user.UserId] = displayName;
            }
        }
        catch { }

        try
        {
            var departmentsByUser = await departmentsTask;
            foreach (var result in departmentsByUser)
            {
                if (result.DepartmentId is not { } department) continue;
                submitterDepartmentIds[result.UserId] = department;
                if (!string.IsNullOrWhiteSpace(result.DepartmentName)) departmentNamesById[department] = result.DepartmentName;
            }
        }
        catch { }
    }

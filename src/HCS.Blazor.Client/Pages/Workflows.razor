@page "/workflow-lists"
@attribute [Authorize(Policy = "Documents.Workflow.View")]
@inherits HCSComponentBase
@inject DocumentClient Documents
@inject IUiMessageService UiMessage
@inject NavigationManager Navigation

<PageTitle>@L["Menu:WorkflowList"] · HCS</PageTitle>
<section class="hcs-catalog-page">
    <header class="hcs-catalog-titlebar">
        <div class="min-w-0"><h1>@L["Menu:WorkflowList"]</h1></div>
        <div class="hcs-catalog-page__actions">
            <Button Color="Color.Primary" Outline="true" Class="hcs-catalog-export" Clicked="LoadAsync" Disabled="@isLoading">@L["Catalog:Refresh"]</Button>
            <AuthorizeView Policy="Documents.Workflow.Manage">
                <Authorized>
                    <Button Color="Color.Primary" Class="hcs-catalog-create" Clicked="OpenCreate"><Icon Name="@IconName.Add" /> @L["Catalog:New"]</Button>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>
    <Card Class="mb-2 hcs-catalog-filter-card"><CardBody>
        <div class="hcs-catalog-filter-row">
            <Addons Class="hcs-catalog-search">
                <Addon AddonType="AddonType.Body"><TextInput @bind-Value="filter" Placeholder="@L["Catalog:SearchPlaceholder"]" /></Addon>
                <Addon AddonType="AddonType.End"><Button Color="Color.Primary" Clicked="ApplySearch"><i class="fa fa-search me-1"></i> @L["Catalog:SearchButton"]</Button></Addon>
            </Addons>
            <Button Color="Color.Primary" Outline="true" Class="hcs-catalog-filter-toggle" Clicked="() => showFilters = !showFilters">
                <i class="fa fa-sliders me-2"></i>@L["Catalog:Filter"]
                <i class="fa @(showFilters ? "fa-chevron-up" : "fa-chevron-down") ms-2"></i>
            </Button>
        </div>
        @if (showFilters)
        {
            <div class="hcs-catalog-advanced-filter">
                <Field>
                    <FieldLabel>@L["Work:Kind"]</FieldLabel>
                    <CatalogSelect2 Value="kindId" ValueChanged="OnKindChanged" Placeholder="@L["Work:Kind"]"
                                    SelectedText="@KindName(kindId)" Search="SearchKindsAsync" />
                </Field>
                <Field>
                    <FieldLabel>@L["Work:IsActive"]</FieldLabel>
                    <Select TValue="string" @bind-Value="activeFilter" @bind-Value:after="OnActiveChanged">
                        <SelectItem Value="@string.Empty">@L["Catalog:AllStatuses"]</SelectItem>
                        <SelectItem Value="@("true")">@L["Catalog:Active"]</SelectItem>
                        <SelectItem Value="@("false")">@L["Catalog:Inactive"]</SelectItem>
                    </Select>
                </Field>
                <Button Color="Color.Light" Outline="true" Class="hcs-catalog-filter-reset" Clicked="ResetSearch">@L["Catalog:Reset"]</Button>
            </div>
        }
    </CardBody></Card>
    <Card Class="hcs-catalog-grid-card"><CardBody>
        <DataGrid TItem="WorkflowDefinitionDto" Data="@pageItems" TotalItems="@totalCount" ReadData="OnReadAsync"
                  ShowPager="true" ShowPageSizes="true" PageSizes="@pageSizes" PageSize="@pageSize"
                  Responsive="true" Striped="true" Hoverable="true" Class="hcs-catalog-grid">
            <EmptyTemplate>
                <div class="hcs-empty py-5"><i class="fa fa-inbox"></i><h2>@L["Catalog:EmptyTitle"]</h2><p>@L["Catalog:EmptyDescription"]</p></div>
            </EmptyTemplate>
            <LoadingTemplate>
                <div class="hcs-loading py-5"><i class="fa fa-spinner fa-spin"></i><span>@L["Catalog:Loading"]</span></div>
            </LoadingTemplate>
            <DataGridColumns>
                <DataGridColumn TItem="WorkflowDefinitionDto" Caption="@L["Catalog:Code"].Value">
                    <DisplayTemplate Context="cell"><strong>@cell.Item.Name</strong><span class="hcs-catalog-code">#@cell.Item.Code</span></DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="WorkflowDefinitionDto" Caption="@L["Work:Kind"].Value">
                    <DisplayTemplate Context="cell">@KindName(cell.Item.KindId)</DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="WorkflowDefinitionDto" Caption="@L["Feature:AddStep"].Value">
                    <DisplayTemplate Context="cell">@cell.Item.Steps.Count</DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="WorkflowDefinitionDto" Caption="@L["Feature:Templates"].Value">
                    <DisplayTemplate Context="cell">@templates.Count(x => x.DefinitionId == cell.Item.Id)</DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="WorkflowDefinitionDto" Caption="@L["Work:IsActive"].Value">
                    <DisplayTemplate Context="cell">@(cell.Item.IsActive ? L["Catalog:Active"] : L["Catalog:Inactive"])</DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="WorkflowDefinitionDto" Caption="@L["Catalog:Actions"].Value">
                    <DisplayTemplate Context="cell">
                        <div class="hcs-row-actions">
                            <Button Size="Size.Small" Color="Color.Primary" Outline="true" Class="hcs-action-button hcs-action-button--edit" Clicked="() => Edit(cell.Item)"><Icon Name="@IconName.Edit" /></Button>
                            <AuthorizeView Policy="Documents.Workflow.Manage">
                                <Authorized>
                                    <Button Size="Size.Small" Color="Color.Danger" Outline="true" Class="hcs-action-button hcs-action-button--delete" Clicked="() => DeleteAsync(cell.Item)"><Icon Name="@IconName.Delete" /></Button>
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    </DisplayTemplate>
                </DataGridColumn>
            </DataGridColumns>
        </DataGrid>
    </CardBody></Card>
</section>

<Modal @ref="modal"><ModalContent Centered Class="hcs-catalog-modal">
    <ModalHeader Class="hcs-catalog-modal__header"><ModalTitle>@L["Work:CreateWorkflow"]</ModalTitle><CloseButton /></ModalHeader>
    <ModalBody Class="hcs-catalog-modal__body">
        <div class="hcs-catalog-form">
            <Field><FieldLabel>@L["Work:Kind"]</FieldLabel>
                <CatalogSelect2 Value="form.KindId"
                                ValueChanged="value => form.KindId = value"
                                Placeholder="@L["Work:Kind"]"
                                SelectedText="@KindName(form.KindId)"
                                Search="SearchKindsAsync" />
            </Field>
            <div class="hcs-form-row">
                <Field><FieldLabel>@L["Catalog:Code"]</FieldLabel><HcsIsolatedTextInput @bind-Value="form.Code" Name="hcsWorkflowListCode" MaxLength="64" /></Field>
                <Field><FieldLabel>@L["Catalog:Name"]</FieldLabel><HcsIsolatedTextInput @bind-Value="form.Name" Name="hcsWorkflowListName" /></Field>
            </div>
            <Field><FieldLabel>@L["Work:Description"]</FieldLabel><textarea class="form-control" rows="3" @bind="form.Description"></textarea></Field>
            <Field><FieldLabel>@L["Work:SignMode"]</FieldLabel>
                <Select TValue="string" @bind-Value="form.SignMode">
                    <SelectItem Value="@("SEQUENTIAL")">@L["Work:SignMode.SEQUENTIAL"]</SelectItem>
                    <SelectItem Value="@("PARALLEL")">@L["Work:SignMode.PARALLEL"]</SelectItem>
                </Select>
            </Field>
            <Field><Check TValue="bool" @bind-Checked="form.IsActive">@L["Work:IsActive"]</Check></Field>
        </div>
    </ModalBody>
    <ModalFooter Class="hcs-catalog-modal__footer">
        <Button Color="Color.Secondary" Class="hcs-catalog-cancel" Clicked="() => modal!.Hide()">@L["Catalog:Cancel"]</Button>
        <Button Color="Color.Primary" Class="hcs-catalog-save" Clicked="SaveCreateAsync" Disabled="@isSaving">@L["Catalog:SaveChanges"]</Button>
    </ModalFooter>
</ModalContent></Modal>
@code {
    private static readonly int[] pageSizes = [10, 20, 50, 100];
    private readonly List<WorkflowDefinitionDto> definitions = [];
    private readonly List<WorkflowDefinitionDto> pageItems = [];
    private readonly List<WorkflowTemplateDto> templates = [];
    private readonly List<WorkflowKindDto> kinds = [];
    private readonly WorkflowCreateForm form = new();
    private Modal? modal;
    private string filter = "", search = "", activeFilter = "";
    private Guid? kindId;
    private bool isLoading, isSaving, showFilters, loaded;
    private int totalCount, pageSize = 20, currentPage = 1;

    private List<WorkflowDefinitionDto> FilteredDefinitions
    {
        get
        {
            IEnumerable<WorkflowDefinitionDto> query = definitions;
            if (!string.IsNullOrWhiteSpace(search))
                query = query.Where(x => x.Code.Contains(search, StringComparison.OrdinalIgnoreCase) || x.Name.Contains(search, StringComparison.OrdinalIgnoreCase));
            if (kindId is { } id) query = query.Where(x => x.KindId == id);
            if (activeFilter == "true") query = query.Where(x => x.IsActive);
            if (activeFilter == "false") query = query.Where(x => !x.IsActive);
            return query.ToList();
        }
    }

    private async Task OnReadAsync(DataGridReadDataEventArgs<WorkflowDefinitionDto> args)
    {
        currentPage = Math.Max(args.Page, 1);
        pageSize = Math.Clamp(args.PageSize, 10, 100);
        if (!loaded) await LoadAsync();
        else ApplyPage();
    }

    private void ApplySearch() { search = SearchText.Normalize(filter); currentPage = 1; ApplyPage(); }
    private void ResetSearch() { filter = search = activeFilter = ""; kindId = null; showFilters = false; currentPage = 1; ApplyPage(); }
    private Task OnKindChanged(Guid? value) { kindId = value; currentPage = 1; ApplyPage(); return Task.CompletedTask; }
    private void OnActiveChanged() { currentPage = 1; ApplyPage(); }
    private void ApplyPage()
    {
        var filtered = FilteredDefinitions;
        totalCount = filtered.Count;
        pageItems.Clear();
        pageItems.AddRange(filtered.Skip((currentPage - 1) * pageSize).Take(pageSize));
    }
    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            definitions.Clear(); definitions.AddRange(await Documents.GetDefinitionsAsync());
            templates.Clear(); templates.AddRange(await Documents.GetTemplatesAsync());
            kinds.Clear(); kinds.AddRange(await Documents.GetKindsAsync());
            loaded = true;
            ApplyPage();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
        finally { isLoading = false; }
    }
    private async Task OpenCreate()
    {
        form.Reset();
        if (modal is not null) await modal.Show();
    }
    private void Edit(WorkflowDefinitionDto item) => Navigation.NavigateTo($"/workflow-detail/{item.Id}");
    private async Task SaveCreateAsync()
    {
        if (string.IsNullOrWhiteSpace(form.Code) || string.IsNullOrWhiteSpace(form.Name))
        {
            await NotifyErrorAsync(L["Catalog:TypeRequired"]);
            return;
        }
        isSaving = true;
        try
        {
            var steps = new List<WorkflowStepInput> { new("review", L["Feature:StepName"], 1, "Documents.Workflow.Decide", "PROCESS") };
            var id = await Documents.CreateDefinitionAsync(new CreateWorkflowDefinitionRequest(
                form.Code.Trim(), form.Name.Trim(), steps, form.KindId, form.Description, form.IsActive, form.SignMode));
            if (modal is not null) await modal.Hide();
            await NotifySuccessAsync(L["Catalog:Created"]);
            Navigation.NavigateTo($"/workflow-detail/{id}");
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
        finally { isSaving = false; }
    }
    private async Task DeleteAsync(WorkflowDefinitionDto item)
    {
        if (!await UiMessage.Confirm(string.Format(L["Catalog:DeleteConfirmation"], item.Name))) return;
        try { await Documents.DeleteDefinitionAsync(item.Id); await LoadAsync(); }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Delete); }
    }
    private string KindName(Guid? id) => id is null ? "" : kinds.FirstOrDefault(x => x.Id == id)?.Name ?? "";
    private Task<CatalogSelect2SearchResponse> SearchKindsAsync(string term, int page)
    {
        term = SearchText.Normalize(term);
        var found = kinds.Where(x => string.IsNullOrWhiteSpace(term)
            || x.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
            || x.Code.Contains(term, StringComparison.OrdinalIgnoreCase)).ToList();
        return Task.FromResult(CatalogSelect2Cache.Merge(kinds, found, x => x.Id, x => CatalogSelect2Text.CodeName(x.Code, x.Name), false));
    }

    private sealed class WorkflowCreateForm
    {
        public Guid? KindId { get; set; }
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string SignMode { get; set; } = "SEQUENTIAL";
        public bool IsActive { get; set; } = true;
        public void Reset()
        {
            KindId = null; Code = Name = Description = ""; SignMode = "SEQUENTIAL"; IsActive = true;
        }
    }
}

@page "/calendar-event-detail/{EventId:guid}"
@attribute [Authorize(Policy = "WorkManagement.Calendar")]
@inherits HCSComponentBase
@inject WorkManagementClient Work
@inject CollaborationClient Chat
@inject IUiMessageService UiMessage
@inject NavigationManager Navigation

<PageTitle>@L["Feature:EventDetail"] · HCS</PageTitle>
<section class="hcs-document-page">
    <header class="hcs-document-page__header">
        <div><h1>@(item?.Title ?? L["Feature:EventDetail"])</h1>@if (item is not null) { <p>@item.StartTime.ToLocalTime() – @item.EndTime.ToLocalTime() · @item.Visibility</p> }</div>
        <div>
            @if (RelatedHref() is { } relatedHref)
            {
                <a class="btn btn-outline-secondary me-2" href="@relatedHref">@L["Work:OpenRelated"]</a>
            }
            <a class="btn btn-outline-primary" href="/calendar-events">@L["Feature:BackToList"]</a>
        </div>
    </header>
    @if (item is not null)
    {
        <Card Class="mb-3"><CardBody>
            <div class="hcs-catalog-form">
            <Field><FieldLabel>@L["Feature:Event"]</FieldLabel><HcsIsolatedTextInput @bind-Value="form.Title" Name="hcsEventDetailTitle" /></Field>
            <Field><FieldLabel>@L["Feature:Description"]</FieldLabel><textarea class="form-control" rows="3" @bind="form.Description" autocomplete="off"></textarea></Field>
            <Field><FieldLabel>@L["Feature:Visibility"]</FieldLabel>
                <Select TValue="string" @bind-Value="form.Visibility">
                    <SelectItem Value="@("Private")">Private</SelectItem>
                    <SelectItem Value="@("Participants")">Participants</SelectItem>
                    <SelectItem Value="@("Public")">Public</SelectItem>
                </Select>
            </Field>
            <Field><FieldLabel>@L["Chat:SelectContacts"]</FieldLabel>
                @foreach (var contact in contacts)
                {
                    <Check TValue="bool" Checked="form.Participants.Contains(contact.Id)" CheckedChanged="@((bool value) => Toggle(contact.Id, value))">@contact.DisplayName</Check>
                }
            </Field>
            <Button Color="Color.Primary" Clicked="SaveAsync">@L["Catalog:SaveChanges"]</Button>
            <Button Color="Color.Danger" Outline="true" Clicked="DeleteAsync">@L["Catalog:Delete"]</Button>
            </div>
        </CardBody></Card>
    }
</section>
@code {
    [Parameter] public Guid EventId { get; set; }
    private CalendarEventDto? item;
    private readonly EventForm form = new();
    private readonly List<HCS.CollaborationService.Contracts.ChatContactDto> contacts = [];

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            item = await Work.GetCalendarEventAsync(EventId);
            form.Title = item.Title; form.Description = item.Description ?? ""; form.Visibility = item.Visibility;
            form.Participants.Clear(); foreach (var id in item.ParticipantUserIds) form.Participants.Add(id);
            if (contacts.Count == 0) contacts.AddRange(await Chat.GetContactsAsync(null, 50));
        }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
    }

    private string? RelatedHref() => item is null ? null : WorkUi.RelatedEntityHref(item.RelatedType, item.RelatedId);
    private void Toggle(Guid id, bool selected) { if (selected) form.Participants.Add(id); else form.Participants.Remove(id); }
    private async Task SaveAsync()
    {
        if (item is null) return;
        try
        {
            item = await Work.UpdateCalendarEventAsync(EventId, new UpsertCalendarEventRequest(form.Title.Trim(), string.IsNullOrWhiteSpace(form.Description) ? null : form.Description, item.StartTime, item.EndTime, item.AllDay, item.EventType, item.Location, item.RelatedType, item.RelatedId, form.Visibility, form.Participants.ToList()));
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }
    private async Task DeleteAsync()
    {
        if (!await UiMessage.Confirm(L["Catalog:DeleteConfirmation"].Value)) return;
        try { await Work.DeleteCalendarEventAsync(EventId); Navigation.NavigateTo("/calendar-events"); }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Delete); }
    }
    private sealed class EventForm
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Visibility { get; set; } = "Private";
        public HashSet<Guid> Participants { get; } = [];
    }
}

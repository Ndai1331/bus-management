@using Volo.Abp.AspNetCore.Components.Web.LeptonXLiteTheme.Themes.LeptonXLite
@using Volo.Abp.AspNetCore.Components.Web.Theming.Routing
@using Microsoft.Extensions.Options
@inject IOptions<AbpRouterOptions> RouterOptions
<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="RouterOptions.Value.AdditionalAssemblies">
    <Found Context="routeData">
        <CascadingAuthenticationState>
            <BffAuthenticationGate>
                <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(HCSMainLayout)">
                    <NotAuthorized>
                        <main class="container py-5">
                            <h1>Không có quyền truy cập</h1>
                            <p>Tài khoản của bạn chưa được cấp quyền cho chức năng này.</p>
                        </main>
                    </NotAuthorized>
                </AuthorizeRouteView>
            </BffAuthenticationGate>
        </CascadingAuthenticationState>
    </Found>
</Router>

@inherits HCSComponentBase

<CatalogSelect2 Value="@Value"
                ValueChanged="@ValueChanged"
                Values="@Values"
                ValuesChanged="@ValuesChanged"
                Multiple="@Multiple"
                Placeholder="@(string.IsNullOrWhiteSpace(Placeholder) ? L["Catalog:PleaseSelect"].Value : Placeholder)"
                SelectedText="@SelectedText"
                SelectedTexts="@SelectedTexts"
                SelectedItem="@SelectedItem"
                SelectedItems="@SelectedItems"
                UserTemplate="true"
                CssClass="hcs-catalog-select2 hcs-user-select2"
                Search="@Search" />


                
@code {
    [Parameter] public Guid? Value { get; set; }
    [Parameter] public EventCallback<Guid?> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<Guid> Values { get; set; } = [];
    [Parameter] public EventCallback<IReadOnlyList<Guid>> ValuesChanged { get; set; }
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? SelectedText { get; set; }
    [Parameter] public IReadOnlyList<string>? SelectedTexts { get; set; }
    [Parameter] public CatalogSelect2Item? SelectedItem { get; set; }
    [Parameter] public IReadOnlyList<CatalogSelect2Item>? SelectedItems { get; set; }
    [Parameter] public Func<string, int, Task<CatalogSelect2SearchResponse>> Search { get; set; } = default!;
}

@namespace HCS.Blazor.Client.Components
@inherits HCSComponentBase

<Card Class="mb-2 hcs-catalog-filter-card">
    <CardBody>
        <Row Class="align-items-end g-3">
            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is7.OnDesktop">
                <Row Class="align-items-center g-2">
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is4.OnDesktop">
                        <label class="fw-bold mb-2 mb-md-0">@L["Work:FilterByDateRange"]</label>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is8.OnDesktop">
                        <HcsDatePicker TValue="IReadOnlyList<DateTime?>"
                                       Value="SelectedDateRange"
                                       ValueChanged="SelectedDateRangeChanged"
                                       InputMode="DateInputMode.Date"
                                       SelectionMode="DateInputSelectionMode.Range"
                                       DisplayFormat="dd/MM/yyyy"
                                       Placeholder="@L["Work:SelectDateRange"]" />
                    </Column>
                </Row>
            </Column>
            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is5.OnDesktop">
                <Field Margin="Margin.Is0">
                    <FieldLabel>@L["Work:SigningExportDateFilter"]</FieldLabel>
                    <Select TValue="string" SelectedValue="@DateFilterField" SelectedValueChanged="DateFilterFieldChanged">
                        <SelectItem Value="@("IncomingDate")">@L["Work:SigningExportDateFilterIncoming"]</SelectItem>
                        <SelectItem Value="@("WorkflowDeadline")">@L["Work:SigningExportDateFilterWorkflow"]</SelectItem>
                    </Select>
                </Field>
            </Column>
        </Row>
        <Row Class="align-items-end g-3 mt-0">
            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is7.OnDesktop">
                <Row Class="align-items-center g-2">
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is4.OnDesktop">
                        <label class="fw-bold mb-2 mb-md-0">@L["Catalog:SearchButton"]</label>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is8.OnDesktop">
                        <FieldLabel>@L["Work:FilterSubmitter"]</FieldLabel>
                        <UserSelect2 Value="SubmitterUserId"
                                     ValueChanged="SubmitterUserIdChanged"
                                     Placeholder="@L["Work:FilterSubmitter"]"
                                     SelectedText="@SubmitterText"
                                     Search="SearchUsers" />
                    </Column>
                </Row>
            </Column>
            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is5.OnDesktop">
                <FieldLabel>@L["Work:FilterDepartment"]</FieldLabel>
                <CatalogSelect2 Value="DepartmentId"
                                ValueChanged="DepartmentIdChanged"
                                Placeholder="@L["Work:FilterDepartment"]"
                                SelectedText="@DepartmentText"
                                Search="SearchDepartments" />
            </Column>
        </Row>
        <Row Class="align-items-end g-3 mt-0">
            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is7.OnDesktop">
                <Row Class="align-items-center g-2">
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is4.OnDesktop"></Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is8.OnDesktop">
                        <TextInput Value="@FilterText" ValueChanged="OnFilterTextChanged" Placeholder="@L["Work:SearchByTitleOrNumber"]" />
                    </Column>
                </Row>
            </Column>
            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is5.OnDesktop">
                <Button Color="Color.Primary" Clicked="SearchClicked" Class="w-100 mt-2 mt-md-0">
                    <i class="fa fa-search me-1"></i> @L["Catalog:SearchButton"]
                </Button>
            </Column>
        </Row>
    </CardBody>
</Card>
@code {
    [Parameter] public IReadOnlyList<DateTime?> SelectedDateRange { get; set; } = [];
    [Parameter] public EventCallback<IReadOnlyList<DateTime?>> SelectedDateRangeChanged { get; set; }
    [Parameter] public string DateFilterField { get; set; } = "IncomingDate";
    [Parameter] public EventCallback<string> DateFilterFieldChanged { get; set; }
    [Parameter] public Guid? SubmitterUserId { get; set; }
    [Parameter] public EventCallback<Guid?> SubmitterUserIdChanged { get; set; }
    [Parameter] public string? SubmitterText { get; set; }
    [Parameter] public Guid? DepartmentId { get; set; }
    [Parameter] public EventCallback<Guid?> DepartmentIdChanged { get; set; }
    [Parameter] public string? DepartmentText { get; set; }
    [Parameter] public string FilterText { get; set; } = "";
    [Parameter] public EventCallback<string> FilterTextChanged { get; set; }
    [Parameter] public EventCallback SearchClicked { get; set; }
    [Parameter] public Func<string, int, Task<CatalogSelect2SearchResponse>> SearchUsers { get; set; } = default!;
    [Parameter] public Func<string, int, Task<CatalogSelect2SearchResponse>> SearchDepartments { get; set; } = default!;

    private Task OnFilterTextChanged(string value)
    {
        FilterText = value ?? "";
        return FilterTextChanged.InvokeAsync(FilterText);
    }
}
